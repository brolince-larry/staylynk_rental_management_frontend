# Relative on purpose — routes through the Vite dev proxy (see vite.config.ts) so the
# frontend and API are same-origin in dev. An absolute value here (e.g. http://127.0.0.1:80)
# makes every request cross-origin, which forces a CORS preflight (OPTIONS) round-trip in
# front of every call that carries the Authorization/X-Device-FP/X-Request-ID headers —
# that's the "duplicate" request pairs (me, me / options, options) show up in devtools.
VITE_API_BASE_URL=/
VITE_REVERB_APP_KEY=ewe4blzwmkn5lxrn6cg1
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

VITE_MEDIA_CDN_URL=
VITE_PROPERTY_VIDEO_MAX_UPLOAD_KB=102400

# Public house-hunter frontend (staylynk-public)
VITE_PUBLIC_SITE_URL=http://localhost:5174
